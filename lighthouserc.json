{
  "ci": {
    "collect": {
      "startServerCommand": "npm run build && npm run preview -- --host 0.0.0.0 --port 4173",
      "startServerReadyPattern": "Local:",
      "url": ["http://localhost:4173/"]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.5 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
